<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title + Amount Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvExpenseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Electric Bill"
                android:textColor="#111827"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/tvExpenseAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৳ 1200"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold" />
        </LinearLayout>

        <!-- Type + Date Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvExpenseType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:background="#E0F2FE"
                android:padding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#BFDBFE"
                android:backgroundTintMode="src_in" />

            <TextView
                android:id="@+id/tvExpenseDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04 Jul 2025"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <!-- Optional Description -->
        <TextView
            android:id="@+id/tvExpenseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly electric bill for mosque"
            android:textColor="#4B5563"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:visibility="gone"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
